# Copy to .env.local; fill locally. Never commit real credentials.
MYSQL_URL=mysql://hackmatch:CHANGE_ME@127.0.0.1:3307/hackmatch
# Set true for hosted MySQL; certificates are verified.
MYSQL_SSL=false
# Hosted MySQL CA certificate (PEM); accepts real newlines or literal \n.
# Download from your provider. Never disable certificate verification.
MYSQL_SSL_CA=
# Optional Unix socket for native local MySQL only. Omit on Vercel.
# MYSQL_SOCKET=/path/to/mysql.sock
MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=hackmatch
APP_ORIGIN=http://localhost:3000
SEED_PASSWORD=
