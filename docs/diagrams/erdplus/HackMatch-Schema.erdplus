      {
        "id": "3600de7c-307e-524c-ad21-d2819a2a215f",
        "type": "Label",
        "position": {
          "x": 20,
          "y": 850
        },
        "data": {
          "label": "MySQL relational schema \u2014 six tables, six foreign keys\napplications: UNIQUE(user_id, team_id). kind distinguishes applications/invitations.\nmemberships: captain_team_id = IF(is_captain, team_id, NULL), STORED, UNIQUE.\nmember_count is maintained by membership triggers; do not update it directly.\nMySQL CHECKs, triggers, views and stored procedure remain in sql/schema.sql.\nMongoDB collections belong to the ER/document model, not to the SQL schema."
        },
        "measured": {
          "width": 1070,
          "height": 180
        },
        "selected": false,
        "dragging": false
      }
    ],
