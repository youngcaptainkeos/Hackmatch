        },
        "data": {
          "label": "HackMatch: existing conceptual ER model\nPROFILE = participant_profiles; OPENING = team_openings.\nDashed document references are application-managed, not SQL foreign keys.\nOne current team per participant; captain existence is maintained by API transactions."
        },
